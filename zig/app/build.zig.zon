.{
    .name = .otto_lite,
    .version = "0.0.1",
    .fingerprint = 0x5672452d5e9089f6,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .nanoui = .{ .path = "../vendor/nanoui" },
        .otto_core = .{ .path = "../core" },
        // zig/ports 是一个 package、三个 module：监听 / 缩略图 / 能力表。
        // 三个依赖名都指向 ../ports：`ports_dep.module("otto_watch")` 之类。
        .ports = .{ .path = "../ports" },
        .thumb = .{ .path = "../ports" },
        .caps = .{ .path = "../ports" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "fixtures",
    },
}
